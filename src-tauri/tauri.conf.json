{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkRead",
  "version": "0.5.1",
  "identifier": "com.markread.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:front"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkRead",
        "width": 1100,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "hiddenTitle": true,
        "backgroundColor": "#fafafa",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown 文档",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {}
}
